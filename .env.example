# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).

# From Meta for Developers > your app > WhatsApp > API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Any random string you choose; paste the same value into Meta's webhook setup
VERIFY_TOKEN=change-me

# From Meta app > Settings > Basic > App secret. Used to verify requests are really from Meta
APP_SECRET=

# Optional: the owner's WhatsApp number (country code, digits only) to get new-booking alerts
OWNER_PHONE=
